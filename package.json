{
  "name": "angular-datatables.net-workspace",
  "version": "21.0.0",
  "description": "Angular directive for DataTables",
  "private": true,
  "scripts": {
    "start": "ng serve angular-datatables.net-demo",
    "build:lib": "npm run clean && ng build angular-datatables.net --configuration=production && npm run lib:schematics:build",
    "clean": "rimraf --glob lib/**/index.{d.ts,js,js.map,metadata.json} demo/**/*.{d.ts,js,map,metadata.json} schematics/**/*.{d.ts,js,map}",
    "demo:test": "ng test angular-datatables.net-demo",
    "demo:test-ui": "ng test angular-datatables.net-demo",
    "demo:test-ci": "ng test angular-datatables.net-demo --no-watch --no-progress",
    "lib:test": "ng test angular-datatables.net",
    "lib:test-ci": "ng test angular-datatables.net --no-watch --no-progress",
    "lib:schematics:build": "rimraf dist/lib/schematics && tsc -p lib/tsconfig.schematics.json && copyfiles lib/schematics/{{collection,migrations}.json,**/schema.json} dist",
    "lib:schematics:test": "npm run lib:schematics:test:build && npm run lib:schematics:test:run",
    "lib:schematics:test:build": "rimraf dist/lib/schematics && tsc -p lib/tsconfig.schematics.spec.json && copyfiles lib/schematics/{{collection,migrations}.json,**/schema.json} dist",
    "lib:schematics:test:run": "cross-env NODE_OPTIONS=\"--import tsx\" vitest --config ./lib/vitest.schematics.config.ts --no-watch",
    "demo:build:prod": "npm run clean && ng build angular-datatables.net-demo --configuration production --base-href=/angular-datatables.net/",
    "demo:build:dev": "npm run clean && ng build angular-datatables.net-demo --configuration development",
    "version": "npm run build:lib && git add -A",
    "postversion": "git push && git push --tags",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "lint:lib": "ng lint angular-datatables.net",
    "lint:lib:fix": "ng lint angular-datatables.net --fix",
    "lint:demo": "ng lint angular-datatables.net-demo",
    "lint:demo:fix": "ng lint angular-datatables.net-demo --fix",
    "copy-readme": "cp README.md dist/lib"
  },
  "keywords": [
    "Angular",
    "DataTables"
  ],
  "author": "Louis LIN <lin.louis@pm.me> (https://l-lin.github.io/)",
  "contributors": [
    "Michael Bennett <michael@strukt.org>",
    "Steven Masala <me@smasalai.com>",
    "Surya Teja K <shanmukhateja@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Vinccool96/angular-datatables.net.git"
  },
  "bugs": {
    "url": "https://github.com/Vinccool96/angular-datatables.net/issues"
  },
  "homepage": "https://github.com/Vinccool96/angular-datatables.net#readme",
  "schematics": "./lib/schematics/src/collection.json",
  "license": "MIT",
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "clipboard": "^2.0.11",
    "core-js": "^3.49.0",
    "datatables.net": "^2.3.7",
    "datatables.net-buttons": "^3.2.6",
    "datatables.net-buttons-dt": "^3.2.6",
    "datatables.net-colreorder": "^2.1.2",
    "datatables.net-colreorder-dt": "^2.1.2",
    "datatables.net-dt": "^2.3.7",
    "datatables.net-fixedcolumns": "^5.0.5",
    "datatables.net-fixedcolumns-dt": "^5.0.5",
    "datatables.net-responsive": "^3.0.8",
    "datatables.net-responsive-dt": "^3.0.8",
    "datatables.net-select": "^3.1.3",
    "datatables.net-select-dt": "^3.1.3",
    "jquery": "^3.7.1",
    "jszip": "^3.10.1",
    "marked": "^17.0.6",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "rxjs": "^7.8.2",
    "tether": "^3.0.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/language-service": "^22.0.0",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@ngneat/spectator": "^22.1.0",
    "@types/jquery": "^3.5.34",
    "@types/node": "^25.5.2",
    "@vitest/browser-webdriverio": "^4.1.8",
    "@vitest/eslint-plugin": "^1.6.16",
    "angular-eslint": "^22.0.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-perfectionist": "^5.8.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "linklocal": "^2.8.2",
    "ng-mocks": "^14.15.3",
    "ng-packagr": "^22.0.0",
    "ngx-markdown": "^22.0.0",
    "prettier": "^3.8.1",
    "rimraf": "~6.1.3",
    "tsx": "^4.21.0",
    "type-fest": "^5.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.8",
    "webdriverio": "^9.28.0"
  }
}
